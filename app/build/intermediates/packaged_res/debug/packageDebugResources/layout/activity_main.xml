<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/splashRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/splash_purple"
    android:clipChildren="true">

    <ImageView
        android:layout_width="342dp"
        android:layout_height="281dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="-5dp"
        android:src="@drawable/cloude"
        android:contentDescription="@string/cloud_description" />
    <ImageView
        android:layout_width="228dp"
        android:layout_height="204dp"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="-52dp"
        android:layout_marginBottom="115dp"
        android:src="@drawable/cloude"
        android:contentDescription="@string/cloud_description" />
    <ImageView
        android:layout_width="194dp"
        android:layout_height="167dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="-13dp"
        android:layout_marginBottom="-16dp"
        android:src="@drawable/cloude"
        android:contentDescription="@string/cloud_description" />

    <ImageView
        android:layout_width="230dp"
        android:layout_height="82dp"
        android:layout_gravity="center"
        android:src="@drawable/hello_marker"
        android:scaleType="fitCenter"
        android:contentDescription="@string/name_splash" />
</FrameLayout>
