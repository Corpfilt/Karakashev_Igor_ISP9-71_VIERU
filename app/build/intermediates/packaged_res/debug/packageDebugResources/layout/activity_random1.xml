<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lavender">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:layout_marginBottom="10dp">
        <TextView
            android:id="@+id/txtNumber"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/random_zero"
            android:textColor="@color/white"
            android:gravity="center"
            android:fontFamily="sans-light"
            android:includeFontPadding="false"
            android:textSize="148sp"
            android:layout_marginBottom="38dp" />
        <Button android:id="@+id/btnPlus"
            style="@style/Kval.MenuButton"
            android:layout_width="190dp" android:layout_height="55dp"
            android:textSize="34sp" android:text="@string/random_plus" />
        <Button android:id="@+id/btnMinus"
            style="@style/Kval.MenuButton"
            android:layout_width="190dp" android:layout_height="55dp"
            android:layout_marginTop="12dp"
            android:textSize="34sp" android:text="@string/random_minus" />
        <Button android:id="@+id/btnGenerate"
            style="@style/Kval.MenuButton"
            android:layout_width="232dp" android:layout_height="58dp"
            android:layout_marginTop="14dp"
            android:textSize="21sp" android:text="@string/random_getnum" />
    </LinearLayout>
</FrameLayout>
